# Endpoint del formulario de contacto (Formspree).
# Por defecto se usa el definido en src/components/ui/ContactForm.jsx; descomenta para sustituirlo.
# Si lo dejas vacío (VITE_CONTACT_ENDPOINT=), el formulario abre el cliente de correo (mailto).
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx

# URL de la API de TrainTracker (plan gratuito de Render). Al abrir el portfolio se le hace una petición
# mínima para despertarla. Si no se define, no se hace ninguna petición.
VITE_TRAINTRACKER_API_URL=https://tu-api.onrender.com/
